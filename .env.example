# Supabase client configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI provider keys belong in Supabase Edge Function secrets.
# Do NOT put private provider API keys in this file or in client-side code.

# Optional: restrict browser requests to your deployed frontend origin
APP_ORIGIN=https://your-domain.example
