# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy fallback for older Supabase projects: VITE_SUPABASE_ANON_KEY=your_legacy_anon_key

# AI provider secrets belong ONLY in Supabase Edge Function secrets.
# Never put these in Vite variables, localStorage, GitHub, or browser code.
# OPENAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# DEEPSEEK_API_KEY=...

# Exact production frontend origin used by the chat Edge Function.
APP_ORIGIN=https://your-domain.example

# Phase 2 (knowledge layer) needs no extra environment variables.
# Apply supabase/migrations/20260903120000_phase2_knowledge.sql (creates the
# private "knowledge" Storage bucket + policies) and redeploy the chat function.
